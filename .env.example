# Copia para .env e preenche. NÃO versionar o .env.

# Segredo partilhado que protege os três endpoints /api/* (contrato-preview,
# gerar-contrato, render-pdf). FALHA FECHADA: sem isto, respondem 503 e não
# abrem a ninguém. Tem de ser IGUAL ao CONTRATOS_PDF_TOKEN definido no
# sportrail-dashboard, que é quem os chama.
PDF_API_TOKEN=

# É tudo. Esta app não tem estado: não liga à base de dados, não guarda
# ficheiros, não tem utilizadores. As variáveis que aqui estavam antes
# (SUPABASE_*, ADMIN_USER/ADMIN_PASS, BASE_URL, DRIVE_ROOT_FOLDER_ID) saíram
# com as rotas que tinham estado — isso vive agora no dashboard.
