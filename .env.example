# Copia para .env e preenche. NÃO versionar o .env.

# URL pública da app (para os links de assinatura saírem corretos em produção).
# Em local podes deixar em branco.
BASE_URL=https://contratos.sportrail.pt

# Basic Auth da zona de coordenação (criar lotes / dashboard). FALHA FECHADA:
# sem AMBAS definidas, "/" e /lote/* respondem 503 — nunca abrem. Em produção
# (Render) o ADMIN_PASS define-se à mão no Environment (render.yaml: sync:false).
# Em local usa os valores de exemplo abaixo e arranca com
#   uvicorn app:app --reload --port 8000 --env-file .env
# Só caracteres ASCII na password: o FastAPI descodifica o header Basic em
# ASCII e rejeitava sempre uma password com acentos (401 sem fim).
# As páginas /assinar/<token> e /pdf/<token> não usam isto (o token autoriza).
ADMIN_USER=admin
ADMIN_PASS=muda-me-em-local

# Segredo partilhado que protege o endpoint POST /api/gerar-contrato (o motor
# de PDF chamado pelo dashboard). Tem de ser IGUAL ao CONTRATOS_PDF_TOKEN
# definido no dashboard. Sem isto, o endpoint responde 503.
PDF_API_TOKEN=

# ID da pasta-raiz DTP no Google Drive (do URL da pasta).
# Só necessário para arquivo real no Drive; sem isto, arquiva em data/arquivo/.
DRIVE_ROOT_FOLDER_ID=
